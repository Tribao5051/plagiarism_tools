          ],
          "dc.description.abstract": [
            {
              "value": "The main objective of this thesis is to develop an real-estate data collection and analysis system, specifically data from Vietnamese C2C e-commerce websites. The built system needs to meet the data source of the nature of big data, with a distributed col lection, storage and processing mechanism. At the same time, the system also needs to solve some problems arising in the collection process such as anti-crawling. In addition to the collected data, the thesis also proposes a decision support application using some machine learning methods for data mining.",
              "language": null,
              "authority": null,
              "confidence": -1,
              "place": 0
            }
